            "url": "{{baseUrl}}/auth/me",
            "description": "Input: Authorization Bearer not-a-token. Expected: 401 Invalid or expired token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-08 fake token is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql('Invalid or expired token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
