    {
      "name": "4 Bookings",
      "description": "EH-16 to EH-23. Create is POST. List is GET and has no body.",
      "item": [
        {
          "name": "EH-16 List bookings before creating one",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings?eventId={{eventId1}}",
            "description": "Input: eventId1 and the token. No body. Expected: total 0. Empty data is correct here."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-16 no booking yet', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().pagination.total).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-17 Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "description": "POST, not GET. eventId has no quotes. Fields are customerName, customerEmail, customerPhone. quantity is 1 with no quotes. Expected: 201, confirmed, totalPrice 10.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId1}},\n  \"customerName\": \"Priya Sharma\",\n  \"customerEmail\": \"priya.sharma@email.com\",\n  \"customerPhone\": \"9876543210\",\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-17 one ticket is booked', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.status).to.eql('confirmed');",
                  "    pm.expect(data.quantity).to.eql(1);",
                  "    pm.expect(Number(data.totalPrice)).to.eql(10);",
                  "    pm.collectionVariables.set('bookingId', String(data.id));",
                  "});"
                ]
              }
            }
