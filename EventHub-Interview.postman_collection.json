{
  "info": {
    "name": "EventHub interview",
    "description": "Run the whole collection from top to bottom. The first request creates a new email. Same cases as the PDF and the Playwright interview suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.eventhub.rahulshettyacademy.com/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "secret12"
    },
    {
      "key": "marker",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "eventId1",
      "value": ""
    },
    {
      "key": "eventId2",
      "value": ""
    },
    {
      "key": "eventId3",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "page1Ids",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "description": "EH-01 to EH-06.",
      "item": [
        {
          "name": "EH-01 Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Input: new email and password secret12. Expected: 201 and a token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('email', 'learner.' + stamp + '@example.com');",
                  "pm.collectionVariables.set('password', 'secret12');",
                  "pm.collectionVariables.set('marker', 'case-' + stamp);",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-01 register returns 201 and a token', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.collectionVariables.set('token', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-02 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Input: the same email and password secret12. Expected: 200 and a token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-02 login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-03 Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Input: Authorization Bearer token. Expected: 200 and the same email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-03 email matches', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-04 Register the same email again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Input: the same email and password. Expected: 400 Email already registered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-04 duplicate email is rejected', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql('Email already registered');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-05 Short password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Input: a new email and password abc. Expected: 400 and a password field error.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"short.{{marker}}@example.com\",\n  \"password\": \"abc\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-05 short password is rejected', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const fields = pm.response.json().details.map(function (row) { return row.field; });",
                  "    pm.expect(fields).to.include('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-06 Invalid email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Input: email not-an-email and password secret12. Expected: 400 and an email field error.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"secret12\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EH-06 invalid email is rejected', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const fields = pm.response.json().details.map(function (row) { return row.field; });",
                  "    pm.expect(fields).to.include('email');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
