              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function sendRegister(email) {",
                  "    return new Promise(function (resolve, reject) {",
                  "        pm.sendRequest({",
                  "            url: pm.collectionVariables.get('baseUrl') + '/auth/register',",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: { mode: 'raw', raw: JSON.stringify({ email: email, password: 'secret12' }) }",
                  "        }, function (err, res) { if (err) reject(err); else resolve(res); });",
                  "    });",
                  "}",
                  "return (async function () {",
                  "    const stamp = Date.now();",
                  "    const results = await Promise.all([",
                  "        sendRegister('one.' + stamp + '@example.com'),",
                  "        sendRegister('two.' + stamp + '@example.com')",
                  "    ]);",
                  "    pm.test('EH-33 both registrations succeed', function () {",
                  "        pm.expect(results[0].code).to.eql(201);",
                  "        pm.expect(results[1].code).to.eql(201);",
                  "    });",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "EH-34 Two bookings for the last seat",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Creates an event with 1 seat, then sends two bookings together. Seats must not go below 0. A correct lock would return one 201 and one 400. This server often accepts both."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function send(method, path, token, body) {",
                  "    const headers = { 'Content-Type': 'application/json' };",
                  "    if (token) headers.Authorization = 'Bearer ' + token;",
                  "    const req = { url: pm.collectionVariables.get('baseUrl') + path, method: method, header: headers };",
                  "    if (body) req.body = { mode: 'raw', raw: JSON.stringify(body) };",
                  "    return new Promise(function (resolve, reject) {",
                  "        pm.sendRequest(req, function (err, res) { if (err) reject(err); else resolve(res); });",
                  "    });",
                  "}",
                  "return (async function () {",
                  "    const token = pm.collectionVariables.get('token');",
                  "    const created = await send('POST', '/events', token, {",
                  "        title: 'last seat', description: 'one', category: 'Concert', venue: 'Hall', city: 'Mumbai',",
                  "        eventDate: '2027-12-01T10:00:00.000Z', price: 80, totalSeats: 1",
                  "    });",
                  "    const eventId = created.json().data.id;",
                  "    const ticket = { eventId: eventId, customerName: 'Priya Sharma', customerEmail: 'priya.sharma@email.com', customerPhone: '9876543210', quantity: 1 };",
                  "    const results = await Promise.all([",
                  "        send('POST', '/bookings', token, ticket),",
                  "        send('POST', '/bookings', token, ticket)",
                  "    ]);",
                  "    const after = await send('GET', '/events/' + eventId, token);",
                  "    pm.test('EH-34 seats do not go below 0', function () {",
                  "        pm.expect([201, 400]).to.include(results[0].code);",
                  "        pm.expect([201, 400]).to.include(results[1].code);",
                  "        pm.expect(after.json().data.availableSeats).to.be.at.least(0);",
                  "    });",
                  "    await send('DELETE', '/events/' + eventId, token);",
                  "})();"
                ]
              }
            }
          ]
        },
