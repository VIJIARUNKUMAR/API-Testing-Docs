            "url": "{{baseUrl}}/users",
            "description": "Input: name Learner Case, email learner.<time>@example.com, gender female, status active, Bearer token. Expected: 201 and the same email. The id is saved.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Learner Case\",\n  \"email\": \"learner@example.com\",\n  \"gender\": \"female\",\n  \"status\": \"active\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'learner.' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('userEmail', email);",
                  "pm.request.body.update(JSON.stringify({",
                  "    name: 'Learner Case',",
                  "    email: email,",
                  "    gender: 'female',",
                  "    status: 'active'",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-08 user is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    pm.expect(body.name).to.eql('Learner Case');",
                  "    pm.expect(body.gender).to.eql('female');",
                  "    pm.expect(body.status).to.eql('active');",
                  "    pm.collectionVariables.set('userId', String(body.id));",
                  "});"
                ]
              }
            }
          ]
        },
