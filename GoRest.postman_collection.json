{
  "info": {
    "name": "GoRest API",
    "description": "27 requests. Writes use your token. The default budget is 90 requests per minute. Run the collection once. Do not loop it. Paste your token into the collection variable named token before you run. Get the token at https://gorest.co.in/my-account/access-tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const remaining = pm.response.headers.get('X-RateLimit-Remaining');",
          "if (remaining !== null && remaining !== '') {",
          "    pm.test('rate limit still has room', function () {",
          "        pm.expect(Number(remaining), 'Stop. Fewer than 10 calls are left this minute.').to.be.at.least(10);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://gorest.co.in/public/v2"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "page1Id",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Read and pagination",
      "description": "No token. These calls do not spend your token budget.",
      "item": [
        {
          "name": "GR-01 Page 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users?page=1&per_page=2",
            "description": "Input: page 1, per_page 2. Expected: 200, two users, X-Pagination-Page 1, X-Pagination-Limit 2.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-01 page 1 returns two users', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json();",
                  "    pm.expect(rows).to.be.an('array').with.lengthOf(2);",
                  "    pm.expect(pm.response.headers.get('X-Pagination-Page')).to.eql('1');",
                  "    pm.expect(pm.response.headers.get('X-Pagination-Limit')).to.eql('2');",
                  "    pm.expect(Number(pm.response.headers.get('X-Pagination-Total'))).to.be.above(2);",
                  "    pm.collectionVariables.set('page1Id', String(rows[0].id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GR-02 Page 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users?page=2&per_page=2",
            "description": "Input: page 2, per_page 2. Expected: 200, two users, page header 2, first id is not the id from page 1.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-02 page 2 is a different pair', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json();",
                  "    pm.expect(rows).to.have.lengthOf(2);",
                  "    pm.expect(pm.response.headers.get('X-Pagination-Page')).to.eql('2');",
                  "    pm.expect(String(rows[0].id)).to.not.eql(pm.collectionVariables.get('page1Id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GR-03 Filter active women",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users?gender=female&status=active&per_page=5",
            "description": "Input: gender female, status active, per_page 5. Expected: 200, every row is female and active.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-03 every row matches the filter', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json();",
                  "    pm.expect(rows.length).to.be.above(0);",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(row.gender).to.eql('female');",
                  "        pm.expect(row.status).to.eql('active');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GR-04 Unknown user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/999999999",
            "description": "Input: id 999999999. Expected: 404 and message Resource not found.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-04 missing user is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().message).to.eql('Resource not found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GR-05 per_page above 100",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users?per_page=101",
            "description": "Input: per_page 101. The documented maximum is 100. Expected: 200 and X-Pagination-Limit 10. The value 101 is ignored.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-05 101 is ignored and the page size stays 10', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('X-Pagination-Limit')).to.eql('10');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GR-06 XML list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{baseUrl}}/users.xml?per_page=1",
            "description": "Input: users.xml and per_page 1. Expected: 200, content type xml, body starts with an objects list.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-06 XML response', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('xml');",
                  "    pm.expect(pm.response.text()).to.include('<objects');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Users",
      "description": "Writes need the token. GR-07 checks that a missing token is rejected.",
      "item": [
        {
          "name": "GR-07 Create user with no token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "Input: a valid user and no Authorization header. Expected: 401 and message Authentication failed.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Token\",\n  \"email\": \"notoken@example.com\",\n  \"gender\": \"male\",\n  \"status\": \"active\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GR-07 missing token is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().message).to.eql('Authentication failed');",
                  "});"
                ]
              }
            }
          ]
        },
